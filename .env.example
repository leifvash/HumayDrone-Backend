# Django Configuration
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# Database (PostgreSQL on Railway, Render, Supabase, Neon, etc.)
# If left empty, Django will default to local SQLite (db.sqlite3)
# Example: postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_URL=

# Celery / Inference execution mode
# Set to True for serverless / single-container deployment without Redis (tasks run in-memory synchronously)
CELERY_ALWAYS_EAGER=True

# Optional Celery & Redis URLs (if running a separate Celery worker with Redis)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Supabase Storage (dedicated public 'inference-media' bucket) & Auth JWT verification
# Recommended (new keys): set SUPABASE_SECRET_KEY=sb_secret_... and SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (Legacy SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY names are also accepted as aliases.)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=inference-media
# Optional: only needed for legacy HS256 JWTs; leave empty if using ECC (ES256) signing keys (/auth/v1/user verifies automatically)
SUPABASE_JWT_SECRET=
